{
  "name": "wine-cellar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:pack": "node scripts/desktop-build.mjs --dir",
    "desktop:dist": "node scripts/desktop-build.mjs --win nsis"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^0.27.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "papaparse": "^5.4.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.winecellar.desktop",
    "productName": "Wine Cellar",
    "directories": {
      "output": "desktop-dist",
      "buildResources": "build"
    },
    "files": [
      ".next/standalone/**/*",
      ".next/standalone/node_modules/.prisma/**/*",
      "electron/**/*"
    ],
    "afterPack": "scripts/desktop-after-pack.cjs",
    "asar": false,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
